# Copy this file to .apt-deploy.env (which is git-ignored) and fill in your key.
#   cp .apt-deploy.env.example .apt-deploy.env
#
# Used by `make apt-thugs-red` via scripts/apt-deploy.sh.
# NEVER commit the real key.

# API token for apt.thugs.red
XXC_APT_KEY=xxc_aptd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# APT_ENDPOINT=https://apt.thugs.red/api/upload
# APT_DIST=stable
# APT_COMPONENT=main
# APT_AUTH_HEADER=Authorization: Bearer
