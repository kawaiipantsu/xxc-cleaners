# Copy this file to .apt-deploy.env (which is git-ignored) and fill in your token.
#   cp .apt-deploy.env.example .apt-deploy.env
#
# Used by `make apt-thugs-red` via scripts/apt-deploy.sh -> scripts/apt_deploy.py.
# Implements the XXC-APTD admin API v1 (https://apt.thugs.red/api).
# NEVER commit the real token.

# Bearer token for the THUGS(red) APT admin API (format: xxc_aptd_<64 hex>).
XXC_APT_KEY=xxc_aptd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API base. The PUBLIC host (apt.thugs.red) only serves docs; the
# management handlers live behind an operator-enabled admin proxy/host.
# Set this to the base your operator gave you if it differs.
# XXC_API_BASE=https://apt.thugs.red/admin/api/v1

# Target suite (case-sensitive) your token is authorized for.
# XXC_SUITE=zerotrust

# Optional:
# XXC_STAGE_ONLY=1        # upload & stage but do not publish
# XXC_ALLOW_REMOVALS=1    # allow publishing a diff that removes/downgrades packages
# XXC_POLL_TIMEOUT=900    # seconds to wait for the publish job
